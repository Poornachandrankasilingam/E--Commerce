# ==============================================================================
# Mr & Mrs Clothing Store: Environment Variables Blueprint (.env.example)
# "Style for Him. Elegance for Her."
# ==============================================================================

# --- FRONTEND CLIENT ENVIRONMENT (Vite / React) ---
# Supabase Project URL & Anon Key (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Razorpay Client Key ID (from Razorpay Dashboard -> Settings -> API Keys)
# Use 'rzp_test_...' for Sandbox testing or 'rzp_live_...' for Production
VITE_RAZORPAY_KEY_ID=rzp_test_luxuryfashionMM

# Optional Backend API Base URL (if running Express server alongside)
VITE_API_URL=http://localhost:5000

# --- BACKEND SERVER ENVIRONMENT (Node.js & Express) ---
PORT=5000
NODE_ENV=development

# Razorpay Secret Keys (NEVER expose to frontend code)
RAZORPAY_KEY_ID=rzp_test_luxuryfashionMM
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Supabase Service Role Key (for backend elevated administrative operations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
